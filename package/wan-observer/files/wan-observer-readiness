#!/bin/sh
# SPDX-License-Identifier: MIT
# Read-only setup checks. Never runs a measurement, enables cron, or accepts a license.
set -eu
config=${WAN_OBSERVER_CONFIG:-/etc/wan-observer/collector.json}
cron=${WAN_OBSERVER_CRONTAB:-/etc/crontabs/root}
lib=${WAN_OBSERVER_LIB:-/usr/share/wan-observer}
scheduler_service=unknown
if command -v pidof >/dev/null 2>&1; then
  scheduler_service=stopped
  if pidof crond >/dev/null 2>&1; then scheduler_service=running; fi
fi
scheduler=missing
if [ -f "$cron" ] && awk '
  /^[[:space:]]*#/ { next }
  # A new word beginning # starts a shell comment; attached/escaped # does not.
  { for (i=8; i<=NF; i++) if (substr($i,1,1) == "#") { NF=i-1; break } }
  # Verify only the documented minute tick, not arbitrary cron expressions.
  (NF == 7 || (NF == 9 && $8 == ">/dev/null" && $9 == "2>&1")) &&
    $1 == "*" && $2 == "*" && $3 == "*" && $4 == "*" && $5 == "*" &&
    $6 == "/usr/bin/wan-observer-collect" && $7 == "tick" { found=1 }
  END { exit !found }
' "$cron"; then scheduler=installed; fi
config_status=missing
binary_status=unknown
status=config_missing
if [ -L "$config" ] || [ -e "$config" ]; then
  config_status=invalid
  status=config_invalid
  # Reuse the collector schema, including its one-object framing requirement.
  if [ ! -L "$config" ] && [ -f "$config" ] && validated=$(jq -L "$lib" -sce 'import "collector" as c; if length == 1 then .[0]|c::valid_config else error("one object required") end' "$config" 2>/dev/null); then
    config_status=valid
    binary=$(printf '%s' "$validated" | jq -r '.binary')
    binary_status=unavailable
    if [ -f "$binary" ] && [ -x "$binary" ]; then binary_status=available; fi
    status=ready
    if [ "$scheduler_service" = stopped ]; then status=scheduler_stopped; fi
    if [ "$scheduler" = missing ]; then status=scheduler_missing; fi
    if [ "$(printf '%s' "$validated" | jq -r '.enabled')" = true ] && [ "$binary_status" = unavailable ]; then status=binary_missing; fi
    # Passive history uses the same minute tick even when full tests are paused.
    if [ "$(printf '%s' "$validated" | jq -r '.enabled or .quality_history_enabled')" = false ]; then status=disabled; fi
  fi
fi
clock_initialized=false
now=${WAN_OBSERVER_NOW:-$(date +%s)}
case "$now" in
  ''|*[!0-9]*) :;;
  *) if [ "${#now}" -le 10 ] && [ "$now" -ge 1704067200 ] && [ "$now" -le 4102444799 ]; then clock_initialized=true; fi;;
esac
if [ "$status" = ready ] && [ "$clock_initialized" = false ]; then status=clock_uninitialized; fi
storage=${WAN_OBSERVER_STORE:-/etc/wan-observer/history}
while [ ! -d "$storage" ] && [ "$storage" != / ] && [ "$storage" != . ]; do storage=$(dirname "$storage"); done
free_storage=$(df -Pk "$storage" 2>/dev/null | awk 'NR==2 && $4 ~ /^[0-9]+$/ { print $4; exit }')
zonename=$(uci -q get 'system.@system[0].zonename' 2>/dev/null) || zonename=
posix=$(uci -q get 'system.@system[0].timezone' 2>/dev/null) || posix=
engine_available=null
case "$binary_status" in available) engine_available=true;; unavailable) engine_available=false;; esac
# Encode only bounded metadata/checks; never return the configuration or paths.
jq -nc --arg status "$status" --arg config "$config_status" --arg binary "$binary_status" \
  --arg scheduler "$scheduler" --arg service "$scheduler_service" \
  --argjson clock "$clock_initialized" --argjson engine "$engine_available" \
  --arg free "$free_storage" --arg zonename "$zonename" --arg posix "$posix" '
  def clean_timezone:
    if length>0 and length<=128 and (explode|all(.>=33 and .<=126 and .!=34 and .!=39 and .!=92))
    then . else null end;
  ($free | try tonumber catch null) as $free_kb |
  {status:$status, checks:{config:$config,binary:$binary,scheduler:$scheduler,scheduler_service:$service,
    clock_initialized:$clock,engine_available:$engine,license_status:"unknown",
    free_storage_kb:(if ($free_kb|type)=="number" and $free_kb>=0 and $free_kb<=9007199254740991 then $free_kb else null end)},
   router_timezone:{zonename:($zonename|clean_timezone),posix:($posix|clean_timezone)}}'
